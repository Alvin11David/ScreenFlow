# API base URL (used by the frontend to make API requests)
# In development, point to your local API server
# In production, point to your deployed API server
VITE_API_BASE_URL=http://localhost:3001

# Database URL (used by Drizzle ORM in the API server)
DATABASE_URL=postgres://user:password@localhost:5432/screenflow

# Base path for the frontend (set to "/" for root deployment, or a subpath)
BASE_PATH=/

# Port for the API server
PORT=3001
