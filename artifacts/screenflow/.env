# API base URL (used by the frontend to make API requests)
# In development, point to your local API server or Railway production
# In production, point to your deployed API server
VITE_API_BASE_URL=https://screenflow-api-production-0196.up.railway.app

# Base path for the frontend (set to "/" for root deployment, or a subpath)
BASE_PATH=/

# Port for the API server
PORT=3001
